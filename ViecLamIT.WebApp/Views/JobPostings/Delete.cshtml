@model ViecLamIT.Domain.Entities.JobPosting

@{
    ViewData["Title"] = "Xác Nhận Xóa";
}

<h1>@ViewData["Title"]</h1>
<h3 class="text-danger">Bạn có chắc chắn muốn xóa tin tuyển dụng này không?</h3>
<div>
    <h4>@Model.Title</h4>
    <hr />
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Xóa" class="btn btn-danger" /> |
        <a asp-action="Index" asp-controller="Employer">Quay lại</a>
    </form>
</div>