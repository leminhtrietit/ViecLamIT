@page
@model ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = "Xác nhận quên mật khẩu";
    Layout = "/Views/Shared/_LayoutBlank.cshtml"; // Dùng layout trống cho đẹp
}

<div class="d-flex align-items-center justify-content-center vh-100 bg-light">
    <div class="card shadow-lg border-0 rounded-4 text-center" style="width: 28rem;">
        <div class="card-body p-4 p-sm-5">
            <h1 class="card-title h2 mb-3">@ViewData["Title"]</h1>

            @if (TempData["PasswordResetMessage"] != null){
                <div class="alert alert-success" role="alert">
                    @TempData["PasswordResetMessage"]
                </div>
            }
            else
            {
                <p>
                    Vui lòng kiểm tra email của bạn để đặt lại mật khẩu.
                </p>
            }
            <div class="mt-4">
                <a asp-page="./Login" class="btn btn-primary">Quay lại trang đăng nhập</a>
            </div>
        </div>
    </div>
</div>