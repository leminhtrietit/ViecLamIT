@model ViecLamIT.WebApp.ViewModels.EmployerDashboardViewModel

@{
    ViewData["Title"] = "Bảng điều khiển Nhà tuyển dụng";
}

<h1>@ViewData["Title"]</h1>
<div class="alert @(Model.CompanyInfo.IsVerified ? "alert-success" : "alert-warning") d-flex justify-content-between align-items-center">
    <div>
        <strong>Trạng thái công ty:</strong>
        @if (Model.CompanyInfo.IsVerified)
        {
            <span>Đã xác thực.</span>
        }
        else
        {
            <span>Chưa xác thực.</span>
        }
    </div>
    @* <div>
        <a asp-controller="Companies" asp-action="Edit" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-pencil-square"></i> Cập nhật thông tin
        </a>
    </div> *@
</div>
<hr />
<h3>Quản lý tin đăng</h3>
<a asp-controller="JobPostings" asp-action="Create" class="btn btn-primary mb-3">Đăng Tin Mới</a>

<ul class="nav nav-tabs" id="myTab" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="active-tab" data-bs-toggle="tab" data-bs-target="#active" type="button">
            Đang hiển thị <span class="badge bg-success">@Model.ApprovedJobs.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="paused-tab" data-bs-toggle="tab" data-bs-target="#paused" type="button">
            Đã ẩn <span class="badge bg-secondary">@Model.PausedJobs.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="pending-tab" data-bs-toggle="tab" data-bs-target="#pending" type="button">
            Chờ duyệt <span class="badge bg-warning text-dark">@Model.PendingJobs.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="rejected-tab" data-bs-toggle="tab" data-bs-target="#rejected" type="button">
            Bị từ chối <span class="badge bg-danger">@Model.RejectedJobs.Count</span>
        </button>
    </li>
</ul>

<div class="tab-content" id="myTabContent">
    <div class="tab-pane fade show active" id="active" role="tabpanel">
        @await Html.PartialAsync("_EmployerJobPostingTablePartial", Model.ApprovedJobs)
    </div>
    <div class="tab-pane fade" id="paused" role="tabpanel">
        @await Html.PartialAsync("_EmployerJobPostingTablePartial", Model.PausedJobs)
    </div>
    <div class="tab-pane fade" id="pending" role="tabpanel">
        @await Html.PartialAsync("_EmployerJobPostingTablePartial", Model.PendingJobs)
    </div>
    <div class="tab-pane fade" id="rejected" role="tabpanel">
        @await Html.PartialAsync("_EmployerJobPostingTablePartial", Model.RejectedJobs)
    </div>
</div>

<!-- Toast Container -->
<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="reasonToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header">
            <strong class="me-auto">Lý do từ chối</strong>
            <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body" id="toastBodyContent">
            <!-- Nội dung lý do sẽ được chèn vào đây -->
        </div>
    </div>
</div>
@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var toastEl = document.getElementById('reasonToast');
            var toast = new bootstrap.Toast(toastEl);
            var toastBody = document.getElementById('toastBodyContent');

            document.querySelectorAll('.view-reason-btn').forEach(function(button) {
                button.addEventListener('click', function() {
                    var reason = this.getAttribute('data-reason');
                    toastBody.textContent = reason || "Không có lý do cụ thể.";
                    toast.show();
                });
            });
        });
    </script>
}