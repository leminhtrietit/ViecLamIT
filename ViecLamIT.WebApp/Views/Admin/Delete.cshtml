@model ViecLamIT.Domain.Entities.ApplicationUser

@{
    ViewData["Title"] = "Xác Nhận Xóa Người Dùng";
}

<h1>@ViewData["Title"]</h1>

<h3 class="text-danger">Bạn có chắc chắn muốn xóa người dùng này không?</h3>
<div>
    <h4>Thông tin người dùng</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Họ và Tên</dt>
        <dd class="col-sm-10">@(Model.FirstName + " " + Model.LastName)</dd>

        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.Email</dd>

        <dt class="col-sm-2">Loại tài khoản</dt>
        <dd class="col-sm-10">@Model.UserType</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Xóa" class="btn btn-danger" /> |
        <a asp-action="ManageUsers">Quay lại danh sách</a>
    </form>
</div>