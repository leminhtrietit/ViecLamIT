@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Quên mật khẩu?";
    Layout = "/Views/Shared/_LayoutBlank.cshtml";
}

<div class="d-flex align-items-center justify-content-center vh-100 bg-light">
    <div class="card shadow-lg border-0 rounded-4" style="width: 24rem;">
        <div class="card-body p-4 p-sm-5">
            <h2 class="card-title text-center mb-2 fw-bold">@ViewData["Title"]</h2>
            <p class="text-center text-muted mb-4">Nhập email của bạn và chúng tôi sẽ gửi cho bạn một liên kết để đặt lại mật khẩu.</p>
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="name@example.com" />
                    <label asp-for="Input.Email" class="form-label"></label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <button type="submit" class="w-100 btn btn-lg btn-primary">Gửi liên kết</button>
            </form>
            <div class="text-center mt-4">
                <p class="mb-0"><a asp-page="./Login">Quay lại trang đăng nhập</a></p>
            </div>
        </div>
    </div>
</div>